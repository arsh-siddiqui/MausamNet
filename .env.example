# ============================================================
# MausamNet — Environment Configuration (PROTOTYPE)
# ------------------------------------------------------------
# The prototype runs 100% offline with SQLite + demo connectors.
# These variables exist so real integrations can be enabled later
# without code changes. Nothing here is required to run the demo.
# ============================================================

# --- Database -------------------------------------------------
# Prototype uses SQLite automatically (backend/database/mausamnet.db).
# Future: MongoDB migration path documented in docs/MONGODB_MIGRATION.md
DATABASE_URL=
MONGODB_URI=

# --- Security (PROVIDE IN PRODUCTION) ------------------------
# Used for JWT signing. Falls back to a demo-only secret in the
# prototype; set this before any real deployment.
JWT_SECRET=change-me-in-production

# --- Government / Meteorological connectors -------------------
IMD_API_URL=
IMD_API_KEY=
MOSDAC_SATELLITE_URL=
SATELLITE_API_URL=
SATELLITE_API_KEY=

# --- Commercial weather APIs ----------------------------------
WEATHER_API_URL=https://api.openweathermap.org
WEATHER_API_KEY=faf6642e62199aeea3f88c2a9ccb9c53

# --- Media / social intelligence ------------------------------
NEWS_API_URL=https://newsapi.org/v2
NEWS_API_KEY=28bc1924ee9b4938ae2254ff93a0c248
SOCIAL_API_URL=
SOCIAL_API_KEY=

# --- Prototype runtime ----------------------------------------
# Demo login credentials (seeded users). Change freely.
DEMO_ANALYST_EMAIL=analyst@mausamnet.demo
DEMO_ANALYST_PASSWORD=demo-analyst-2026
DEMO_VERIFIER_EMAIL=verifier@mausamnet.demo
DEMO_VERIFIER_PASSWORD=demo-verifier-2026
DEMO_ADMIN_EMAIL=admin@mausamnet.demo
DEMO_ADMIN_PASSWORD=demo-admin-2026

# Seed volume for scripts/seed_database.py (override via env)
SEED_SIGNAL_COUNT=18000
